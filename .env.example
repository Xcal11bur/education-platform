# Example environment variables for local development.
# Spring Boot reads OS/process environment variables directly.
# This file is a template for reference or for tooling that can load .env files.

# Database
DB_URL=jdbc:mysql://localhost:3306/education_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# Security
# Required. Use a random string with at least 32 characters.
JWT_SECRET=
LOGIN_CAPTCHA_ENABLED=true

# API docs
SPRINGDOC_ENABLED=false

# OSS
OSS_ENDPOINT=your-oss-endpoint
OSS_BUCKET_NAME=your-bucket-name
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=https://your-bucket-name.your-oss-endpoint
OSS_BASE_PATH=education-platform/materials
